{
  "name": "zotero-chatgpt-web",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src actors scripts tests eslint.config.mjs vitest.config.ts",
    "test:unit": "vitest run && node --test tests/web/*.test.mjs",
    "package:dev": "npm run build && node scripts/package.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "host:prepare": "node scripts/prepare-host-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
